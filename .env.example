# OpsMaster 3-Container Platform Environment Configuration

# Server
PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=10
ENABLE_MOCK_FALLBACK=false

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=clinical_db
DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/clinical_db?sslmode=disable

# Redis (Queue, Cache & WebRTC Session State)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_VITALS_STREAM=vitals:stream
REDIS_ALERTS_CHANNEL=vitals:alerts:critical
REDIS_SESSION_PREFIX=opsmaster:session:
REDIS_SESSION_TTL_SECONDS=86400

# Anomaly Rules Engine Thresholds
SLIDING_WINDOW_SECONDS=30
SLIDING_WINDOW_MIN_SAMPLES=2
THRESHOLD_TACHYCARDIA_BPM=140.0
THRESHOLD_BRADYCARDIA_BPM=45.0
THRESHOLD_HYPOXEMIA_SPO2=90.0
THRESHOLD_CRITICAL_HYPOXEMIA_SPO2=85.0
THRESHOLD_SYSTOLIC_BP_HIGH=180.0

# k6 Sensor Simulator (Load Test Profile)
TARGET_URL=http://app-engine:8080/api/v1/vitals
VIRTUAL_DEVICES=1000
INJECT_ANOMALIES=false
INJECT_LATENCY=false
INJECT_MALFORMED_RATE=0.0
